# Resend API key — create a free account at https://resend.com and generate a key
RESEND_API_KEY=

# Inbox that receives booking enquiries from the contact form
CONTACT_TO_EMAIL=hello@maleekphotography.com

# Sender address. Use onboarding@resend.dev until your domain is verified in Resend,
# then switch to something like enquiries@yourdomain.com
CONTACT_FROM_EMAIL=onboarding@resend.dev
